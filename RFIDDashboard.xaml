<Page x:Class="WPFDBTool.RFIDDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RFID Dashboard">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Early Entry Analysis Chart -->
        <GroupBox Header="Early Entry Analysis" Grid.Row="0" Height="163" VerticalAlignment="Bottom" Margin="533,0,-33,117" Grid.RowSpan="2">
            <lvc:CartesianChart Name="EarlyEntryChart" Margin="52,0,93,0" Height="123" />
        </GroupBox>

        <!-- Late Campus Entry & Exit Report -->
        <GroupBox Header="Late Campus Entry and Exit Report" Grid.Row="1" Margin="10">
            <lvc:CartesianChart Name="LateEntryExitChart" />
        </GroupBox>

        <!-- Gatepass Compliance Tracking -->
        <GroupBox Header="Gatepass Compliance Tracking" Grid.Row="2" Margin="10">
            <lvc:CartesianChart Name="GatepassComplianceChart" />
        </GroupBox>
    </Grid>
</Page>
